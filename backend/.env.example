# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me-to-random-32+-chars

# --- Banco / cache ---
DATABASE_URL=postgresql+psycopg://imoveis:imoveis@localhost:5432/imoveis
REDIS_URL=redis://localhost:6379/0

# --- LLM providers ---
GROQ_API_KEY=
OPENAI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBED_BATCH=50
OCR_INITIAL_SAMPLE_SIZE=50
OCR_MAX_INPUT_CHARS=20000
PHOTO_DIR=/data/photos

# --- Geocoding / mapas ---
NOMINATIM_URL=https://nominatim.openstreetmap.org
GOOGLE_MAPS_API_KEY=

# --- Notificações (Fase 5) ---
N8N_WEBHOOK_URL=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=claytoncosta
N8N_DEFAULT_REMOTE_JID=

# --- Deploy/worker ---
INGEST_IMAGE=ghcr.io/clayprod/imoveis-caixa-ingest:latest
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Crawler ---
CRAWLER_USER_AGENT=imoveis-caixa-pro/0.1 (+https://github.com/seu-user/imoveis-caixa)
CRAWLER_RATE_LIMIT_PER_SECOND=1

# --- Caixa proxy (Cloudflare Worker) ---
# WAF Azion da Caixa bloqueia IPs de cloud. Em prod o backend baixa via worker.
# Local pode deixar vazio (vai direto). Ver worker/README.md.
CAIXA_PROXY_URL=
CAIXA_PROXY_TOKEN=
